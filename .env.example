# ── /api/quote mail configuration ─────────────────────────────────────────
# Copy to .env for local development (never commit the real .env).
# In production set these in Vercel → Settings → Environment Variables.

# Zoho SMTP host and port. Port 465 implies implicit TLS (secure: true).
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465

# The mailbox you authenticate as. Zoho requires the real mailbox here — if
# sales@forucarton.com is only an alias, put the actual mailbox account below
# and keep MAIL_TO as the alias.
SMTP_USER=sales@forucarton.com

# Zoho app-specific password (not your normal account password).
# Zoho → Account → Security → App Passwords.
SMTP_PASS=replace-with-zoho-app-password

# Where quote requests are delivered.
MAIL_TO=sales@forucarton.com

# The From address. May include a display name, e.g.
#   MAIL_FROM="For You Carton <sales@forucarton.com>"
# Defaults to SMTP_USER when unset.
MAIL_FROM=sales@forucarton.com
